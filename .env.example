# Copy to .env for local runs. Mirror these as GitHub Secrets for the self-hosted runner.

AUTOSELL_BASE_URL=https://www.autosell.mx
SYNC_TIMEZONE=America/Chihuahua

# Live sync on account_1 + account_2 (see config.yaml sync.active_accounts).
# account_3 stays out until old Marketplace listings are cleared there.
DRY_RUN=false

# Plan only (no Facebook actions):
# DRY_RUN=true

# Override active accounts (comma-separated); default from config.yaml
# SYNC_ACCOUNTS=account_1,account_2

# Fast FB debug: skip Odoo XML-RPC + live scrape; use data/catalog_latest.json.
# Also exposed as workflow_dispatch input `skip_odoo` on sync.yml / repost.yml.
# SKIP_ODOO=true

# Listing bump: daily incremental (10/account, FIFO by posted_at; min age 2d).
# Override: WEEKLY_BUMP_MODE=auto|renew|repost
# WEEKLY_BUMP_MODE=auto
# Age floor supports fractions (e.g. 1.5). Default 2 days (≈36–48h window).
RENEW_MIN_AGE_DAYS=2
RENEW_MAX_PER_ACCOUNT_PER_RUN=3
FB_RENEW_DELAY_MIN_SEC=20
FB_RENEW_DELAY_MAX_SEC=40

# Full recreate repost (primary path via run_weekly_bump.py / run_repost.py)
REPOST_MIN_AGE_DAYS=2
REPOST_MAX_PER_ACCOUNT_PER_RUN=3
# Exclusive lock (VPS + Actions). Override path if needed.
# BUMP_LOCK_PATH=/tmp/auto_upload_bump.lock
# Hard-delete old listing before create (avoids FB duplicate warning)
# REPOST_REMOVAL_ACTION=delete
# Seconds to wait after verified delete before creating the new listing
# REPOST_DELETE_COOLDOWN_SEC=3
# Close/reopen Chromium every N listings (repost / renew)
FB_REPOST_BROWSER_EVERY=3
FB_RENEW_BROWSER_EVERY=10
FB_BROWSER_REOPEN_MAX=5
# Desktop headed login (Arch/KDE Wayland SIGTRAP mitigations):
# FB_BROWSER_CHANNEL=chromium
# FB_OZONE_PLATFORM=x11
# FB_DISABLE_GPU=1
# FB_CHROME_ARGS=

MAX_POSTS_PER_ACCOUNT_PER_RUN=15
# Live Marketplace slots per account (allocator). Full catalog needs N×25 accounts.
# MAX_LISTINGS_PER_ACCOUNT=25
FB_ACTION_DELAY_MIN_SEC=60
FB_ACTION_DELAY_MAX_SEC=120
REMOVAL_ACTION=mark_sold

DB_PATH=data/sync.db
SNAPSHOT_DIR=data/snapshots

# CI split (matches .github/workflows/sync.yml):
#   python run_sync.py --scrape-only --output data/catalog_latest.json
#   python run_sync.py --from-snapshot data/catalog_latest.json

# Optional alerts when sync / session health / repost fails (Telegram and/or Slack)
# ALERTS_ENABLED=true
# ALERT_PREFIX=auto-upload
# ALERT_HTTP_TIMEOUT_SEC=10
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SLACK_WEBHOOK_URL=

# Session pre-check: open Marketplace once per account before posting/reposting
# (detects logged-out sessions and security checkpoints). Set false to skip.
# FB_SESSION_PRECHECK_LIVE=true

# Catalog ingestion toggles for scripts/run_weekly_bump.py
# SKIP_SCRAPE=false
# SKIP_ODOO=false

# Retention for debug screenshots (data/logs/facebook/*.png) and /tmp/*.log
# LOG_RETENTION_DAYS=7

# Phase 2 — Odoo CRM (xmlrpc). Never commit real secrets.
# CI secrets (sync.yml): ODOO_URL, ODOO_DB, ODOO_USER, ODOO_PASSWORD
# Local aliases also accepted: ODOO_USERNAME, ODOO_API_KEY
# ODOO_URL=https://autosellmx.odoo.com
# ODOO_DB=autosellmx
# ODOO_USER=contabilidad@autosell.mx
# ODOO_PASSWORD=
# ODOO_USERNAME=contabilidad@autosell.mx
# ODOO_API_KEY=
# Optional: default assignee for quote follow-up activities (else team member / uid)
# ODOO_ACTIVITY_USER_ID=
# CRM sales teams (crm.team ids) by branch — Periférico primary
# ODOO_TEAM_PERIFERICO=1
# ODOO_TEAM_SAN_FELIPE=5   # unset / 0 → fall back to Periférico team
# ODOO_SETTER_NAME=Marco
# ODOO_SETTER_LOGIN=marco.setter@autosell.mx
# ODOO_SETTER_USER_ID=   # optional explicit res.users id for Appointment Setter
# Optional fallback crm.stage ids when Beatriz stages cannot be resolved by name
# ODOO_CRM_BEATRIZ_LEAD_STAGE_ID=
# ODOO_CRM_BEATRIZ_CITA_STAGE_ID=
# ODOO_CRM_CITA_STAGE_ID=2   # legacy fallback alias
#
# Round-robin lead distribution: JSON roster per branch (odoo_id = res.users id).
# Catalog tags map to branches: * Periférico, + San Felipe, - consignment (Periférico).
# If REPS_* is empty/unparsed, RoundRobinAssigner falls back to crm.team.member_ids.
# odoo_id must be a real res.users id (omit for desk/phone-only entries).
# Validated against Odoo (2026-09): Alfonso=2 Ivan=7 Aaron=8 Veronica=10 Loreto=11 Alfredo=12 Gonzalo=13
# REPS_PERIFERICO=[{"phone": "+526142274381", "name": "Periferico Desk"}, {"odoo_id": 7, "phone": "+526142032347", "name": "Ivan"}, {"odoo_id": 2, "phone": "+526141639458", "name": "Alfonso"}, {"odoo_id": 10, "phone": "+526141625132", "name": "Veronica"}]
# REPS_SAN_FELIPE=[{"phone": "+526142274381", "name": "San Felipe Desk"}, {"phone": "+526142417711", "name": "Francisco"}, {"odoo_id": 8, "phone": "+526142349504", "name": "Aaron"}, {"phone": "+526145957371", "name": "Charly"}, {"odoo_id": 11, "phone": "+526141764629", "name": "Loreto"}]
# Shared RoundRobinAssigner cursor (survives vapi-bridge / webhook restarts).
# RR_CURSOR_DB_PATH=data/rr_cursor.db
# Set false to mute the 1-on-1 WhatsApp handoff card sent to reps
# REP_NOTIFY_ENABLED=true
# MG Quote Lead stays with AI WhatsApp until appointment / test-drive request
# AI_MG_QUOTE_LEADS=true
# Evolution WhatsApp → Vapi Chat (Beatriz text-first). Auto-on when VAPI_ASSISTANT_ID set.
# VAPI_WA_TEXT_FIRST=true
# VAPI_WA_CHAT_DB_PATH=data/vapi_wa_chats.db
# Default vehicle price when AI builds a trade-in quote without a catalog SKU
# AI_QUOTE_DEFAULT_PRICE=450000
#
# After WhatsApp quote delivery, queue outbound AI voice follow-up
# (POST /api/v1/voice/outbound-call). Dry-run default keeps CI offline-safe.
# VOICE_OUTBOUND_ENABLED=true
# VOICE_OUTBOUND_DRY_RUN=true
# VOICE_OUTBOUND_URL=http://127.0.0.1:8080/api/v1/voice/outbound-call
# VOICE_GATEWAY_BASE_URL=http://127.0.0.1:8080
#
# Vapi outbound dialer (caller ID +52 614 227 4381 / Periférico DID)
# VAPI_API_KEY=
# VAPI_TOKEN=                    # alias accepted by scripts/sync_vapi_tool_urls.py
# VAPI_PHONE_NUMBER_ID=          # Vapi phoneNumberId linked to +526142274381
# VAPI_ASSISTANT_ID=             # optional; else phone number's default assistant
# VAPI_BASE_URL=https://api.vapi.ai
# Server webhook for end-of-call: POST /api/v1/voice/call-status
#
# Quick-tunnel → Vapi tool URL auto-sync (scripts/sync_vapi_tool_urls.py)
# Optional explicit tool IDs (else GET /tool auto-match by path / function name):
# VAPI_TOOL_INVENTORY_ID=608c050b-1203-4495-9433-5a06f6430275
# VAPI_TOOL_CRM_LEAD_ID=15988bc7-8099-4e47-9820-806e11950edd
# VAPI_TOOL_FINANCING_ID=144ed2f7-9429-4be4-ab70-46c17f49947d
# VAPI_TOOL_TRADEIN_ID=d73f1d2d-641d-48d9-bc19-79906968d81f
# QUICK_TUNNEL_LOG=/tmp/oracle_quick_tunnel.log
#
# Vapi inventory tool bridge (Riley → Odoo product.template)
#   Dev:  python -m src.voice_gateway.vapi_bridge
#   Prod: deploy/vapi-bridge.service + deploy/cloudflared-vapi-bridge.service
#         sudo bash deploy/install_vapi_bridge.sh
# VAPI_BRIDGE_HOST=127.0.0.1
# VAPI_BRIDGE_PORT=8000
# VAPI_BRIDGE_RELOAD=false
# Odoo inventory tool timeout (seconds). Default 5 — 1.5 was too tight and
# returned TTS fallback, letting the LLM invent stale prices (e.g. Versa 175k).
# VAPI_INVENTORY_TIMEOUT_SEC=5
# Brand+model specific queries (indexed name ilike) — tighter ceiling for JSON tools.
# VAPI_INVENTORY_SPECIFIC_TIMEOUT_SEC=1.5
# Uses ODOO_URL / ODOO_DB / ODOO_USER|ODOO_USERNAME / ODOO_PASS|ODOO_PASSWORD|ODOO_API_KEY
# Inventory row TTL (seconds). Default 0 = live Odoo (no in-process cache).
# /vapi/inventory always passes use_cache=False regardless. Set e.g. 60 only if needed.
# ODOO_INVENTORY_CACHE_TTL_SEC=0
# Min list_price for published stock (excludes $1 placeholder templates).
# ODOO_INVENTORY_MIN_PRICE=10000
# Studio/state field on product.template (optional). Autosell Odoo 19 has none —
# published stock = sale_ok + active + default_code + min price (sold = archived).
# ODOO_VEHICLE_STATE_FIELD=x_studio_state
#
# Autométrica (trade-in Valor Compra). Live login optional — quote path uses
# data/autometrica_valuations.json. Token workflow: .github/workflows/get_token.yml
# AUTOMETRICA_USER=
# AUTOMETRICA_PASS=
# AUTOMETRICA_TOKEN=
# AUTOMETRICA_LOGIN_URL=https://app240.autometrica.mx/api/user/login
# AUTOMETRICA_VALUATIONS_PATH=data/autometrica_valuations.json
# Optional UTM-like source/medium for CRMLeadManager creates
# Prefer channel-based mapping (auto search/create utm.source / utm.medium):
#   WhatsApp → medium WhatsApp, source WA Directo
#   Facebook Messenger → medium Facebook, source FB Messenger
#   Facebook Lead Ads → medium Facebook Ads, source FB Lead Form
#   Voice / Phone → medium Phone, source Inbound Call
#   Website → medium Website, source Formulario Web
# ODOO_CRM_SOURCE_ID=
# ODOO_CRM_MEDIUM_ID=
# Plan-only for calendar / WhatsApp templates / fleet / attachments (no live writes)
# ODOO_DRY_RUN=false
#
# --- Native Odoo WhatsApp (Meta Cloud API) — PAUSED ---
# Meta Business / WhatsApp Manager admin credentials are pending.
# Leave both unset so template sends soft-fail or use ODOO_DRY_RUN=true for plan-only.
# Code path remains ready: src/odoo_sync/whatsapp.py multi-branch routing.
#
# ODOO_WA_ACCOUNT_PERIFERICO=   # PENDING Meta Manager setup — Odoo whatsapp.account id for Periférico (primary)
# ODOO_WA_ACCOUNT_SAN_FELIPE=   # placeholder / None until San Felipe line is activated
#
# Native templates (Sale Order, Payment Link, Invoice, Payment Receipt) also need
# the Odoo WhatsApp app + Meta-approved templates on the DB — uses ODOO_* only.

# Phase 2 — WhatsApp via Evolution API (Docker: deploy/docker-compose.evolution.yml).
# Isolated from FB Playwright sessions/. Generate key: openssl rand -hex 32
WHATSAPP_PROVIDER=evolution
WHATSAPP_API_URL=http://127.0.0.1:8082
# alias: WHATSAPP_BASE_URL=http://127.0.0.1:8082
WHATSAPP_API_KEY=
# Evolution instance names (one WhatsApp number per branch)
WHATSAPP_INSTANCE_PERIFERICO=autosell_periferico
WHATSAPP_INSTANCE_SAN_FELIPE=autosell_san_felipe
# Optional legacy default for outbound when branch is unknown
# WHATSAPP_INSTANCE_NAME=autosell_periferico
# alias: WHATSAPP_INSTANCE=autosell_periferico
# Evolution container → FastAPI (requires uvicorn --host 0.0.0.0)
WHATSAPP_WEBHOOK_URL=http://host.docker.internal:8080/webhook/whatsapp
# Vapi bridge: customer confirmation WhatsApp after POST /vapi/lead|/vapi/crm-lead (default on)
# VAPI_CUSTOMER_WHATSAPP=true
# Optional MX dial prefix for 10-digit phones: 52 (default) or 521
# WHATSAPP_MX_COUNTRY_PREFIX=52
# AUTOSELL_SITE_URL=https://www.autosell.mx
# Postgres volume password for compose (not the WhatsApp API key)
EVOLUTION_POSTGRES_PASSWORD=
EVOLUTION_SERVER_URL=http://127.0.0.1:8082

# Phase 2 — Voice AI webhook (default crm.team / branch)
# VOICE_DEFAULT_BRANCH_ID=1
# Inbound SIP/VoIP DIDs (digits only match) and rep forward targets for TwiML <Dial>
# VOICE_DID_PERIFERICO=+526141234567
# VOICE_DID_SAN_FELIPE=+526149876543
# VOICE_FORWARD_PERIFERICO=+526141111111
# VOICE_FORWARD_SAN_FELIPE=+526142222222
# PDF_OUTPUT_DIR=data/quotes

# Marketplace listing WhatsApp CTA (wa.me deep links by branch)
# MARKETPLACE_WA_PERIFERICO=526142274381
# MARKETPLACE_WA_SAN_FELIPE=526141293763

# Meta Facebook Page Messenger webhook / Graph API. Never commit real tokens.
# FB_VERIFY_TOKEN=
# FB_PAGE_ACCESS_TOKEN=
# META_DEFAULT_BRANCH_ID=1

# --- Webform leads (marketing@autosell.mx) ---
# IMAP poll every 2 min (deploy/web-leads-imap.timer) OR POST /webhook/web-lead-email
# WEB_LEADS_IMAP_HOST=imap.gmail.com
# WEB_LEADS_IMAP_PORT=993
# WEB_LEADS_IMAP_USER=marketing@autosell.mx
# WEB_LEADS_IMAP_PASSWORD=
# WEB_LEADS_IMAP_FOLDER=INBOX
# WEB_LEADS_SEEN_DB=data/web_leads_seen.db
# WEB_LEAD_STAGE_NAME=Nuevo / Web Lead
# WEB_LEADS_STAGE_NAME=Nuevo / Web Lead   # alias of WEB_LEAD_STAGE_NAME
# WEB_LEADS_DRY_RUN=false
# WEB_LEADS_CUSTOMER_WHATSAPP=true

# Facebook Messenger → WhatsApp redirect (meta_gateway/messenger_autoreply.py)
# FB_MESSENGER_WA_LINK=https://wa.me/526142274381

# --- Commission attribution (src/attribution.py → data/commissions.db) ---
# COMMISSIONS_DB_PATH=data/commissions.db
# COMMISSION_DEFAULT_PERCENTAGE=1.0
# COMMISSION_WON_STAGES=won,ganado,ganada,closed won,vendido,sold
# COMMISSION_LOST_STAGES=lost,perdido,perdida,cancelado,cancelled

