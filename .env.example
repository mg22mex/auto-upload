# Copy to .env for local runs. Mirror these as GitHub Secrets for the self-hosted runner.

AUTOSELL_BASE_URL=https://www.autosell.mx
SYNC_TIMEZONE=America/Chihuahua

# Live sync on account_1 + account_2 (see config.yaml sync.active_accounts).
# account_3 stays out until old Marketplace listings are cleared there.
DRY_RUN=false

# Plan only (no Facebook actions):
# DRY_RUN=true

# Override active accounts (comma-separated); default from config.yaml
# SYNC_ACCOUNTS=account_1,account_2

# Listing bump: daily incremental (15/account, FIFO by posted_at).
# Override: WEEKLY_BUMP_MODE=auto|renew|repost
# WEEKLY_BUMP_MODE=auto
RENEW_MIN_AGE_DAYS=3
RENEW_MAX_PER_ACCOUNT_PER_RUN=15
FB_RENEW_DELAY_MIN_SEC=20
FB_RENEW_DELAY_MAX_SEC=40

# Full recreate repost (primary path via run_weekly_bump.py / run_repost.py)
REPOST_MIN_AGE_DAYS=3
REPOST_MAX_PER_ACCOUNT_PER_RUN=15
# Exclusive lock (VPS + Actions). Override path if needed.
# BUMP_LOCK_PATH=/tmp/auto_upload_bump.lock
# Hard-delete old listing before create (avoids FB duplicate warning)
# REPOST_REMOVAL_ACTION=delete
# Close/reopen Chromium every N listings (repost / renew)
FB_REPOST_BROWSER_EVERY=3
FB_RENEW_BROWSER_EVERY=10
FB_BROWSER_REOPEN_MAX=5
# Desktop headed login (Arch/KDE Wayland SIGTRAP mitigations):
# FB_BROWSER_CHANNEL=chromium
# FB_OZONE_PLATFORM=x11
# FB_DISABLE_GPU=1
# FB_CHROME_ARGS=

MAX_POSTS_PER_ACCOUNT_PER_RUN=10
# Live Marketplace slots per account (allocator). Full catalog needs N×15 accounts.
# MAX_LISTINGS_PER_ACCOUNT=15
FB_ACTION_DELAY_MIN_SEC=60
FB_ACTION_DELAY_MAX_SEC=120
REMOVAL_ACTION=mark_sold

DB_PATH=data/sync.db
SNAPSHOT_DIR=data/snapshots

# CI split (matches .github/workflows/sync.yml):
#   python run_sync.py --scrape-only --output data/catalog_latest.json
#   python run_sync.py --from-snapshot data/catalog_latest.json

# Optional alerts when sync fails (Telegram)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Phase 2 — Odoo CRM (xmlrpc). Never commit real secrets.
# CI secrets (sync.yml): ODOO_URL, ODOO_DB, ODOO_USER, ODOO_PASSWORD
# Local aliases also accepted: ODOO_USERNAME, ODOO_API_KEY
# ODOO_URL=https://autosellmx.odoo.com
# ODOO_DB=autosellmx
# ODOO_USER=api@autosell.mx
# ODOO_PASSWORD=
# ODOO_USERNAME=api@autosell.mx
# ODOO_API_KEY=
# Optional: default assignee for quote follow-up activities (else team member / uid)
# ODOO_ACTIVITY_USER_ID=
# CRM sales teams (crm.team ids) by branch — Periférico primary
# ODOO_TEAM_PERIFERICO=
# ODOO_TEAM_SAN_FELIPE=   # unset / 0 → fall back to Periférico team
# Optional UTM-like source/medium for CRMLeadManager creates
# Prefer channel-based mapping (auto search/create utm.source / utm.medium):
#   WhatsApp → medium WhatsApp, source Facebook Marketplace
#   Voice / Phone → medium Phone, source Inbound Call
#   Website → medium Website, source Autosell Web
# ODOO_CRM_SOURCE_ID=
# ODOO_CRM_MEDIUM_ID=
# Plan-only for calendar / WhatsApp templates / fleet / attachments (no live writes)
# ODOO_DRY_RUN=false
#
# --- Native Odoo WhatsApp (Meta Cloud API) — PAUSED ---
# Meta Business / WhatsApp Manager admin credentials are pending.
# Leave both unset so template sends soft-fail or use ODOO_DRY_RUN=true for plan-only.
# Code path remains ready: src/odoo_sync/whatsapp.py multi-branch routing.
#
# ODOO_WA_ACCOUNT_PERIFERICO=   # PENDING Meta Manager setup — Odoo whatsapp.account id for Periférico (primary)
# ODOO_WA_ACCOUNT_SAN_FELIPE=   # placeholder / None until San Felipe line is activated
#
# Native templates (Sale Order, Payment Link, Invoice, Payment Receipt) also need
# the Odoo WhatsApp app + Meta-approved templates on the DB — uses ODOO_* only.

# Phase 2 — WhatsApp via Evolution API (Docker: deploy/docker-compose.evolution.yml).
# Isolated from FB Playwright sessions/. Generate key: openssl rand -hex 32
WHATSAPP_PROVIDER=evolution
WHATSAPP_API_URL=http://127.0.0.1:8082
# alias: WHATSAPP_BASE_URL=http://127.0.0.1:8082
WHATSAPP_API_KEY=
# Evolution instance names (one WhatsApp number per branch)
WHATSAPP_INSTANCE_PERIFERICO=autosell_periferico
WHATSAPP_INSTANCE_SAN_FELIPE=autosell_san_felipe
# Optional legacy default for outbound when branch is unknown
# WHATSAPP_INSTANCE_NAME=autosell_periferico
# alias: WHATSAPP_INSTANCE=autosell_periferico
# Evolution container → FastAPI (requires uvicorn --host 0.0.0.0)
WHATSAPP_WEBHOOK_URL=http://host.docker.internal:8080/webhook/whatsapp
# Postgres volume password for compose (not the WhatsApp API key)
EVOLUTION_POSTGRES_PASSWORD=
EVOLUTION_SERVER_URL=http://127.0.0.1:8082

# Phase 2 — Voice AI webhook (default crm.team / branch)
# VOICE_DEFAULT_BRANCH_ID=1
# Inbound SIP/VoIP DIDs (digits only match) and rep forward targets for TwiML <Dial>
# VOICE_DID_PERIFERICO=+526141234567
# VOICE_DID_SAN_FELIPE=+526149876543
# VOICE_FORWARD_PERIFERICO=+526141111111
# VOICE_FORWARD_SAN_FELIPE=+526142222222
# PDF_OUTPUT_DIR=data/quotes

# Marketplace listing WhatsApp CTA (wa.me deep links by branch)
# MARKETPLACE_WA_PERIFERICO=526142274381
# MARKETPLACE_WA_SAN_FELIPE=526141293763

# Meta Facebook Page Messenger webhook / Graph API. Never commit real tokens.
# FB_VERIFY_TOKEN=
# FB_PAGE_ACCESS_TOKEN=
# META_DEFAULT_BRANCH_ID=1

