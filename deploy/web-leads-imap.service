[Unit]
Description=Autosell webform IMAP lead ingest (marketing@ → Odoo + Beatriz WA)
Documentation=file:///home/ubuntu/auto-upload/SETUP.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/auto-upload
Environment=PYTHONUNBUFFERED=1
# Do NOT EnvironmentFile= full .env (JSON REPS_* breaks systemd).
# Script loads WorkingDirectory/.env via python-dotenv.
ExecStart=/home/ubuntu/auto-upload/.venv/bin/python scripts/parse_web_leads.py
Nice=10
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
