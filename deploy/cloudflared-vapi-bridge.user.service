[Unit]
Description=Cloudflare named tunnel for Vapi inventory bridge (user)
After=network-online.target vapi-bridge.service
Wants=network-online.target
Requires=vapi-bridge.service

[Service]
Type=simple
# Named tunnel → https://vapi.autosell.mx (see ~/.cloudflared/config.yml)
# HTTP/2 + IPv4 avoids QUIC/Wi-Fi mid-call drops.
ExecStart=%h/.local/bin/cloudflared tunnel --no-autoupdate --protocol http2 --edge-ip-version 4 run vapi-bridge
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=default.target
