[Unit]
Description=Cloudflare quick tunnel for Autosell Vapi inventory bridge
Documentation=https://developers.cloudflare.com/cloudflare-one/connections/connect-apps/
After=network-online.target vapi-bridge.service
Wants=network-online.target
Requires=vapi-bridge.service

[Service]
Type=simple
User=root
Group=root

# Ephemeral trycloudflare.com URL is printed to the journal on start.
# For a stable hostname, replace with a named tunnel + config.yml.
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:8000

Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
