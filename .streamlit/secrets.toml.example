# Streamlit Community Cloud / local secrets template.
# Copy to secrets.toml (gitignored) or paste into the Cloud "Secrets" UI.
#
# Flat form (matches OdooCRMClient env names):
ODOO_URL = "https://autosellmx.odoo.com"
ODOO_DB = "autosellmx"
ODOO_USERNAME = "api@autosell.mx"
ODOO_API_KEY = "REPLACE_WITH_ODOO_API_KEY"

# Nested form also supported:
# [odoo]
# url = "https://autosellmx.odoo.com"
# db = "autosellmx"
# username = "api@autosell.mx"
# api_key = "REPLACE_WITH_ODOO_API_KEY"
