    # Copy to .env for local runs. Mirror these as GitHub Secrets for the self-hosted runner.

AUTOSELL_BASE_URL=https://www.autosell.mx
SYNC_TIMEZONE=America/Chihuahua

# Live sync on account_1 + account_2 (see config.yaml sync.active_accounts).
# account_3 stays out until old Marketplace listings are cleared there.
DRY_RUN=false

# Plan only (no Facebook actions):
# DRY_RUN=true

# Override active accounts (comma-separated); default from config.yaml
# SYNC_ACCOUNTS=account_1,account_2

# Listing bump: primary path is full repost/relist (3-day age). Renew is optional.
RENEW_MIN_AGE_DAYS=3
RENEW_MAX_PER_ACCOUNT_PER_RUN=25
FB_RENEW_DELAY_MIN_SEC=20
FB_RENEW_DELAY_MAX_SEC=40

# Full recreate repost (primary via run_weekly_bump.py / run_repost.py)
REPOST_MIN_AGE_DAYS=3
REPOST_MAX_PER_ACCOUNT_PER_RUN=10

MAX_POSTS_PER_ACCOUNT_PER_RUN=10
FB_ACTION_DELAY_MIN_SEC=60
FB_ACTION_DELAY_MAX_SEC=120
REMOVAL_ACTION=mark_sold

DB_PATH=data/sync.db
SNAPSHOT_DIR=data/snapshots

# CI split (matches .github/workflows/sync.yml):
#   python run_sync.py --scrape-only --output data/catalog_latest.json
#   python run_sync.py --from-snapshot data/catalog_latest.json

# Optional alerts when sync fails (Telegram)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Phase 2 — Odoo CRM (xmlrpc). Never commit real secrets.
# ODOO_URL=https://odoo.example.com
# ODOO_DB=autosell
# ODOO_USERNAME=api@autosell.mx
# ODOO_API_KEY=

# Phase 2 — WhatsApp (Evolution API or open-wa). Isolated from FB sessions/.
# WHATSAPP_PROVIDER=evolution
# WHATSAPP_BASE_URL=https://wa.example.com
# WHATSAPP_API_KEY=
# WHATSAPP_INSTANCE=autosell

# Phase 2 — Voice AI webhook (default crm.team / branch)
# VOICE_DEFAULT_BRANCH_ID=1

